# ==============================================================================
# AI ARTISAN COMMERCE NETWORK - ENVIRONMENT VARIABLES TEMPLATE
# ==============================================================================

# 1. Database Configuration (Optional: SQLite local fallback is enabled by default)
DATABASE_URL=sqlite:///./artisan_network.db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. Authentication Secrets
AUTH_SECRET=sih-2026-artisan-network-secret-key
JWT_EXPIRATION_HOURS=24

# 3. AI & Speech Recognition (Bhashini / Gemini / OpenAI)
AI_API_KEY=your-ai-api-key
BHASHINI_API_KEY=your-bhashini-speech-key
BHASHINI_USER_ID=your-bhashini-user-id

# 4. Payment Gateway (Razorpay Route / Cashfree / ONDC RSP Sandbox)
PAYMENT_GATEWAY_PROVIDER=demo
PAYMENT_KEY=rzp_test_sample_key
PAYMENT_SECRET=sample_payment_secret

# 5. Logistics (India Post / ONDC Logistics Adapter)
LOGISTICS_API_KEY=sample_logistics_api_key

# 6. ONDC Beckn Protocol Config
ONDC_BAP_ID=buyer-app.ondc.org
ONDC_BPP_ID=ai-artisan-network.bpp.org
ONDC_GATEWAY_URL=https://staging.gateway.ondc.org
PORT=8000
